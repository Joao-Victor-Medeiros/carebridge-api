# Autenticação
JWT_SECRET=uma-chave-jwt-local

# Conexão JDBC usada pelo Spring Boot e pelo Flyway
DATABASE_URL=jdbc:postgresql://localhost:5432/carebridge-db
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin

# Variáveis usadas apenas pelo PostgreSQL do docker-compose.yaml
POSTGRES_DB=carebridge-db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Opcional: use false somente depois que todos os bancos existentes já tiverem
# a tabela flyway_schema_history.
FLYWAY_BASELINE_ON_MIGRATE=true

# Relay SMTP transacional da Brevo
BREVO_ENABLED=false
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=CareBridge

# Evita que uma indisponibilidade do SMTP derrube o health geral da API.
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# Criação automática do primeiro usuário administrativo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
