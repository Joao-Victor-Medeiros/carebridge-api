# Autenticação
JWT_SECRET=uma-chave-jwt-local

# Conexão JDBC usada pelo Spring Boot e pelo Flyway
DATABASE_URL=jdbc:postgresql://localhost:5432/carebridge-db
DATABASE_USERNAME=admin
DATABASE_PASSWORD=admin

# Variáveis usadas apenas pelo PostgreSQL do docker-compose.yaml
POSTGRES_DB=carebridge-db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# Opcional: use false somente depois que todos os bancos existentes já tiverem
# a tabela flyway_schema_history.
FLYWAY_BASELINE_ON_MIGRATE=true
