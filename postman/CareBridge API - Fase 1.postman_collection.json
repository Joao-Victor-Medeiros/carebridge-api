    {
      "name": "05 - Segurança",
      "item": [
        {
          "name": "01 - Rota autenticada sem token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Oportunidade usada no teste de autorização\",\n  \"descricao\": \"Esta requisição deve ser bloqueada antes da criação.\",\n  \"tipoServico\": \"consulta\",\n  \"publicoAlvo\": \"adultos\",\n  \"modalidade\": \"online\",\n  \"condicoesAcesso\": \"Agendamento prévio.\",\n  \"statusAtiva\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/oportunidades",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oportunidades"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", function () { pm.response.to.have.status(401); });",
                  "pm.test(\"Erro padronizado\", function () { const body = pm.response.json(); pm.expect(body.statusCode).to.eql(401); pm.expect(body.message).to.eql(\"Sessão expirada ou credenciais inválidas.\"); pm.expect(body.error).to.eql(\"Unauthorized\"); pm.expect(body.requestId).to.be.a(\"string\").and.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Rota profissional com token de paciente",
          "request": {
            "method": "POST",
