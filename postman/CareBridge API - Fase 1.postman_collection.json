    {
      "name": "06 - CORS",
      "item": [
        {
          "name": "01 - Preflight GitHub Pages",
          "request": {
            "method": "OPTIONS",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Origin",
                "value": "https://luisfontinelles.github.io"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "content-type"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Preflight aceito\", function () { pm.expect([200, 204]).to.include(pm.response.code); });",
                  "pm.test(\"Origem liberada\", function () { pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"https://luisfontinelles.github.io\"); pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"POST\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Preflight localhost",
          "request": {
            "method": "OPTIONS",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "content-type,authorization"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Preflight aceito\", function () { pm.expect([200, 204]).to.include(pm.response.code); });",
                  "pm.test(\"Localhost liberado\", function () { pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(\"http://localhost:5173\"); pm.expect(pm.response.headers.get(\"Access-Control-Allow-Methods\")).to.include(\"POST\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Preflight de origem não permitida",
          "request": {
            "method": "OPTIONS",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Origin",
                "value": "https://origem-nao-permitida.example"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "POST"
              },
              {
                "key": "Access-Control-Request-Headers",
                "value": "content-type"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Origem não é liberada\", function () { pm.expect(pm.response.headers.get(\"Access-Control-Allow-Origin\")).to.eql(undefined); });"
                ]
              }
            }
          ]
        }
      ]
    }
