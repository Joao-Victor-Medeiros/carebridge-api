              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Oportunidade usada no teste de autorização\",\n  \"descricao\": \"Esta requisição deve ser bloqueada antes da criação.\",\n  \"tipoServico\": \"consulta\",\n  \"publicoAlvo\": \"adultos\",\n  \"modalidade\": \"online\",\n  \"condicoesAcesso\": \"Agendamento prévio.\",\n  \"statusAtiva\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/oportunidades",
